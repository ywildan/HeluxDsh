<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      androidx.profileinstaller (pulled in transitively via appcompat -> emoji2)
      declares android.permission.DUMP. This app never dumps profiles, so the
      permission is removed from the merged manifest to keep the installed
      permission set exactly CAMERA + INTERNET.
    -->
    <uses-permission
        android:name="android.permission.DUMP"
        tools:node="remove" />

    <!-- The tunnel is the only network path this app uses. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Pairing scans a QR code shown by the Helux Tunnel panel. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.HeluxDsh">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Launched by an explicit Intent from MainActivity. Must be declared or
          startActivity throws ActivityNotFoundException and the app force
          closes as soon as the user taps "Scan QR code".
        -->
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.HeluxDsh" />

    </application>

</manifest>
